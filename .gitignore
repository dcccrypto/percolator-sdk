node_modules/
*.tsbuildinfo
package-lock.json
.env
.env.*
!.env.example

# Private keys, certificates, and credentials
# These patterns match secret-bearing files only. They do not detect
# credentials embedded in source code; use environment variables instead.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
keypair.json
*-keypair.json
# Local-only prompts and notes (not for upstream)
.private/

# dist/ is committed so that GitHub git-dep consumers get pre-built files
# without needing devDependencies (tsup/typescript) installed.
# Always run `pnpm build` before committing changes to src/.
